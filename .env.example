# Copy this file to .env and fill in your own keys.
# Mapbox public token (pk.…) for the campus maps
VITE_MAPBOX_TOKEN=
# OpenWeatherMap API key for live weather, rain and air quality
VITE_OWM_KEY=
# Groq API key for the AI copilot (used by backend/server.py)
GROQ_API_KEY=
# ID queried by Campus Bins > Live; must match the ESP32 BIN_ID
VITE_LIVE_BIN_ID=B-101
# Shared cloud feed for Campus Bins > Live (public publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional local-backend-to-cloud relay; keep the token private in .env
BIN_CLOUD_INGEST_URL=
BIN_CLOUD_INGEST_TOKEN=
