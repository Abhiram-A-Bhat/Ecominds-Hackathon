#pragma once

struct WifiCredential {
  const char* ssid;
  const char* password;
};

// Replace the password with the Motorola Edge 40 hotspot password.
// Keep wifi_credentials.h local; it is excluded from Git because it contains passwords.
const WifiCredential WIFI_NETWORKS[] = {
  {"motorola edge 40_9307", "REPLACE_WITH_HOTSPOT_PASSWORD"}
};

constexpr size_t WIFI_NETWORK_COUNT = sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);
